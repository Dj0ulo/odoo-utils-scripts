{
	"folders": [
		{
			"path": "odoo"
		},
		{
			"path": "enterprise"
		}
	],
    "settings": {
        "python.defaultInterpreterPath": "~/src/venv/bin/python3",
        "python.analysis.extraPaths": [
            "~/src/symlink",
            "~/src/odoo",
            "~/src",
        ],
        "git.ignoreLimitWarning": true,
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Attach",
                "type": "debugpy",
                "request": "attach",
                "connect": {
                    "host": "localhost",
                    "port": 5678
                },
                "justMyCode": false,
                "pathMappings": [
                    {
                        "localRoot": "${workspaceFolder:odoo}",
                        "remoteRoot": "${workspaceFolder:odoo}"
                    }
                ]
            },
        ]
    }
}