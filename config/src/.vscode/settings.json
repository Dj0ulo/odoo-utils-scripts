{
    "python.defaultInterpreterPath": "/home/odoo/src/venv/bin/python3",
    "python.analysis.extraPaths": [
        "./odoo", // for stuff in ~/src/odoo/odoo
        "./enterprise",
    ],
    "python.analysis.autoSearchPaths": true,
    "terminal.integrated.cwd": "odoo",
    "Odoo.selectedProfile": "Disabled",
