#!/usr/bin/env python3
import sys
import subprocess
import os
import re


def infer_current_branch_from_release(src_dir):
    release_file = f'{src_dir}/odoo{"-tmp" if "--tmp" in sys.argv else ""}/odoo/release.py'
    with open(release_file) as f:
        for line in f:
            if line.strip().startswith('version_info'):
                match = re.search(r'version_info\s*=\s*\(([^)]*)\)', line)
                if match:
                    version_info_str = match.group(1)
                    # Split by comma, handle quoted strings and ints
                    parts = [p.strip().strip("'\"")
                             for p in version_info_str.split(',')]
                    version_info = []
                    for part in parts:
                        if part.isdigit():
                            version_info.append(int(part))
                        else:
                            version_info.append(part)
                else:
                    raise RuntimeError("Could not parse version_info line")
                break
        else:
            raise RuntimeError("version_info not found in release.py")

    if isinstance(version_info[0], str) and version_info[0].startswith('saas~'):
        # e.g. ('saas~18', 4, 0, ...)
        major = version_info[0].replace('saas~', '')
        minor = version_info[1]
        return f'saas-{major}.{minor}'
    elif isinstance(version_info[0], int):
        # e.g. (17, 3, 0, ...)
        major = version_info[0]
        minor = version_info[1]
        if minor == 0:
            return f'{major}.0'
        else:
            return f'saas-{major}.{minor}'
    else:
        raise RuntimeError("Unknown version_info format")


def get_current_version_tuple(src_dir):
    branch = infer_current_branch_from_release(src_dir)
    if branch.startswith('saas-'):
        branch = branch[5:]

    major_str, minor_str = branch.split('.', 1)
    return int(major_str), int(minor_str)
    
def generate_db_name():
    current_branch = infer_current_branch_from_release(src_dir)
    if current_branch.startswith('saas'):
        dbname = f'db-{current_branch[5:]}'
    else:
        dbname = f'db-{current_branch}'

    if '--enterprise' in sys.argv or '-e' in sys.argv:
        dbname += '-e'
    
    return dbname


src_dir = os.path.expanduser('~/src')

command = [f'{src_dir}/odoo{"-tmp" if "--tmp" in sys.argv else ""}/odoo-bin']
odoo_bin_args = sys.argv[1:]
extra_addons_paths = []

# Capture user-provided addons paths so we can append them to the computed addons_path.
filtered_args = []
i = 0
while i < len(odoo_bin_args):
    arg = odoo_bin_args[i]
    if arg.startswith('--addons-path='):
        extra_addons_paths += [p for p in arg.split('=', 1)[1].split(',') if p]
    elif arg == '--addons-path' and i + 1 < len(odoo_bin_args):
        i += 1
        extra_addons_paths += [p for p in odoo_bin_args[i].split(',') if p]
    else:
        filtered_args.append(arg)
    i += 1

odoo_bin_args = filtered_args

for arg in ['--internal', '--vscode', '--new', '--upgrade', '--enterprise', '-e', '--tmp']:
    if arg in odoo_bin_args:
        odoo_bin_args.remove(arg)

if odoo_bin_args:
    command += odoo_bin_args

if (
    get_current_version_tuple(src_dir) >= (18, 3)
    and not any('--with-demo' in arg or '--without-demo' in arg for arg in odoo_bin_args)
):
    command.append('--with-demo')

if '-d' in sys.argv:
    dbname = sys.argv[sys.argv.index('-d') + 1]
else:
    dbname = generate_db_name()
    command += ['-d', dbname]

os.chdir(f'{src_dir}/odoo{"-tmp" if "--tmp" in sys.argv else ""}')

addons_path = [
    f'{src_dir}/odoo{"-tmp" if "--tmp" in sys.argv else ""}/addons',
    f'{src_dir}/scripts/addons',
]
if '--enterprise' in sys.argv or '-e' in sys.argv:
    addons_path += [f'{src_dir}/enterprise{"-tmp" if "--tmp" in sys.argv else ""}',
                   f'{src_dir}/design-themes']
if '--internal' in sys.argv:
    addons_path += [f'{src_dir}/internal/private', f'{src_dir}/internal/trial',
                    f'{src_dir}/internal/demo', f'{src_dir}/internal/default']

addons_path += extra_addons_paths

command += [f'--addons-path={",".join(addons_path)}']

if '--tmp' in sys.argv:
    command += ['-p', '8070']

if '--upgrade' in sys.argv:
    upgrade_path = [f'{src_dir}/upgrade-util/src',
                    f'{src_dir}/upgrade/migrations']
    command += [
        '--stop-after-init',
        f'--upgrade-path={",".join(upgrade_path)}',
        '-u all',
    ]

if '--vscode' in sys.argv:
    command = ['python3', '-m', 'debugpy',
               '--listen', 'localhost:5678'] + command + ["--limit-time-real=9999"]

if '--new' in sys.argv:
    confirm = input(f"Are you sure you want to drop the database '{dbname}'? [y/N]: ")
    if confirm.lower() == 'y':
        subprocess.call(['dropdb', dbname])
    else:
        print("Database drop cancelled.")
        exit(0)


def print_complete_command():
    print(' '.join(command))


try:
    print_complete_command()
    print()
    subprocess.call(command)
except:
    pass
finally:
    print()
    print('Odoo terminated, command:')
    print_complete_command()
